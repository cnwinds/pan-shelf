{
  "name": "pan-shelf",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "盘架 PanShelf：同步站点游戏目录，按需转存进百度网盘、随时删除腾空间（Web 控制台）",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server/index.mjs",
    "dev:server": "node --no-warnings=ExperimentalWarning --watch-path=server server/index.mjs",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "setup": "npm install && npm --prefix web install && npm --prefix web run build"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "fastify": "^5.2.0"
  }
}
